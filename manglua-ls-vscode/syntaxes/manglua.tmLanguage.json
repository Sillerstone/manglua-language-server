{
  "name": "MangLua",
  "scopeName": "source.manglua",
  "patterns": [
    {
      "match": "\\b(give|import)\\s+(?:(\"[^\"]+\"|'[^']+')|([A-Za-z_][A-Za-z0-9_]*(?:[.\\/][A-Za-z0-9_]+)*))(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
      "name": "meta.import.manglua",
      "captures": {
        "1": { "name": "keyword.control.import.manglua" },
        "2": { "name": "string.quoted.manglua" },
        "3": { "name": "entity.name.namespace.manglua" },
        "4": { "name": "keyword.control.import.manglua" },
        "5": { "name": "variable.other.alias.manglua" }
      }
    },
    {
      "name": "meta.attribute.manglua",
      "begin": "(@\\[)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.begin.manglua" },
        "2": { "name": "entity.name.function.attribute.manglua" },
        "3": { "name": "punctuation.section.parens.begin.manglua" }
      },
      "end": "(\\))\\s*(\\])",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.manglua" },
        "2": { "name": "punctuation.definition.attribute.end.manglua" }
      },
      "patterns": [
        { "include": "#attr-string" },
        { "include": "#attr-number" },
        { "include": "#attr-named-arg" },
        { "include": "#attr-symbol-path" },
        { "include": "#attr-punctuation" }
      ],
      "repository": {
        "attr-string": {
          "name": "string.quoted.double.manglua",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.manglua",
              "match": "\\\\."
            }
          ]
        },
        "attr-number": {
          "name": "constant.numeric.manglua",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        },
        "attr-named-arg": {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.parameter.attribute.manglua" },
            "2": { "name": "keyword.operator.assignment.manglua" }
          }
        },
        "attr-symbol-path": {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?:(::|\\.)([A-Za-z_][A-Za-z0-9_]*))*",
          "captures": {
            "1": { "name": "entity.name.type.manglua" }
          }
        },
        "attr-punctuation": {
          "patterns": [
            {
              "name": "punctuation.separator.comma.manglua",
              "match": ","
            },
            {
              "name": "punctuation.section.parens.begin.manglua",
              "match": "\\("
            },
            {
              "name": "punctuation.section.parens.end.manglua",
              "match": "\\)"
            }
          ]
        }
      }
    },
    {
      "begin": "\\b(?:(local)\\s+)?(function)\\b(?![,:])",
      "beginCaptures": {
        "1": {
          "name": "keyword.local.manglua"
        },
        "2": {
          "name": "keyword.control.manglua"
        }
      },
      "end": "(?<=[\\)\\-{}\\[\\]\"'])",
      "name": "meta.function.manglua",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.begin.manglua"
            }
          },
          "end": "(\\))|(?=[\\-{}\\[\\]\"'])|(?<!\\.)\\.(?!\\.)",
          "endCaptures": {
