    },
    {
      "match": "(?<![\\w\\d.])0[oO][0-9A-Fa-f]+(?![pPeE.0-9])",
      "name": "constant.numeric.integer.octal.manglua"
    },
    {
      "match": "(?<![\\w\\d.])0[bB][0-9A-Fa-f]+(\\.[0-9A-Fa-f]*)?([eE]-?\\d*)?([pP][-+]\\d+)?",
      "name": "constant.numeric.float.binary.manglua"
    },
    {
      "match": "(?<![\\w\\d.])0[bB]\\.[0-9A-Fa-f]+([eE]-?\\d*)?([pP][-+]\\d+)?",
      "name": "constant.numeric.float.binary.manglua"
    },
    {
      "match": "(?<![\\w\\d.])0[bB][0-9A-Fa-f]+(?![pPeE.0-9])",
      "name": "constant.numeric.integer.binary.manglua"
    },
    {
      "match": "(?<![\\w\\d.])\\d+(\\.\\d*)?([eE]-?\\d*)?",
      "name": "constant.numeric.float.manglua"
    },
    {
      "match": "(?<![\\w\\d.])\\.\\d+([eE]-?\\d*)?",
      "name": "constant.numeric.float.manglua"
    },
    {
      "match": "(?<![\\w\\d.])\\d+(?![pPeE.0-9])",
      "name": "constant.numeric.integer.manglua"
    },
    {
      "include": "#string"
    },
    {
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.manglua"
        }
      },
      "match": "\\A(#!).*$\\n?",
